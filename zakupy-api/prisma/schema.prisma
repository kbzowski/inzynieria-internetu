generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(uuid(7))
  email         String         @unique
  passwordHash  String
  items         Item[]
  refreshTokens RefreshToken[]
}

model Item {
  // uuid(7) zaczyna sie od czasu utworzenia, wiec sortowanie po id daje kolejnosc dodania
  id     String  @id @default(uuid(7))
  name   String
  bought Boolean @default(false)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // nazwa jest unikalna na liscie jednego uzytkownika
  @@unique([userId, name])
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  // w bazie tylko skrot SHA-256, sam token zna wylacznie przegladarka
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
